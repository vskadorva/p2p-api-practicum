{"openapi":"3.1.0","info":{"title":"P2P Practice API","version":"1.0.0","description":"A small purchase-to-pay API for practicing API testing. Data lives in memory and resets on restart or with POST /admin/reset. There is no authentication. Every rejected request returns {\"detail\": \"...\", \"rule\": \"...\"}; 404 responses have no rule."},"servers":[{"url":"http://localhost:8000"}],"components":{"schemas":{"Health":{"type":"object","properties":{"status":{"type":"string","enum":["ok"]}},"required":["status"]},"Reset":{"type":"object","properties":{"status":{"type":"string","enum":["reset"]}},"required":["status"]},"Vendor":{"type":"object","properties":{"id":{"type":"string","example":"vnd-001"},"name":{"type":"string","example":"Maple Ridge Supply"},"active":{"type":"boolean"}},"required":["id","name","active"]},"Error":{"type":"object","properties":{"detail":{"type":"string","example":"Vendor vnd-002 is inactive."},"rule":{"type":"string","enum":["inactive_vendor_gate","receive_quantity_limit","overpayment_protection","three_way_match_gate","partial_receipt_flag","duplicate_invoice_detection","gl_balance","invoice_line_validation","duplicate_approval","workflow_gate","vendor_exposure_math","validation_error"],"description":"The business rule that rejected the request. Missing on 404 responses."}},"required":["detail"]},"VendorCreate":{"type":"object","properties":{"name":{"type":"string","minLength":1},"active":{"type":"boolean","default":true}},"required":["name"]},"VendorExposure":{"type":"object","properties":{"vendor_id":{"type":"string"},"open_ap_liability":{"type":"number","description":"Amount in dollars, rounded to cents.","example":47.5},"approved_invoices":{"type":"array","items":{"type":"string"}}},"required":["vendor_id","open_ap_liability","approved_invoices"]},"Sku":{"type":"object","properties":{"sku":{"type":"string","example":"LUM-2X4-8"},"description":{"type":"string","example":"2x4 stud, 8 ft"},"unit_price":{"type":"number","description":"Amount in dollars, rounded to cents.","example":47.5}},"required":["sku","description","unit_price"]},"PoLine":{"type":"object","properties":{"sku":{"type":"string"},"description":{"type":"string"},"quantity":{"type":"number"},"unit_price":{"type":"number","description":"Amount in dollars, rounded to cents.","example":47.5},"received_quantity":{"type":"number"}},"required":["sku","description","quantity","unit_price","received_quantity"]},"PurchaseOrder":{"type":"object","properties":{"id":{"type":"string","example":"po-1a2b3c4d"},"vendor_id":{"type":"string"},"status":{"type":"string","enum":["draft","submitted","closed"]},"line_items":{"type":"array","items":{"$ref":"#/components/schemas/PoLine"}},"ordered_value":{"type":"number","description":"Amount in dollars, rounded to cents.","example":47.5},"received_value":{"type":"number","description":"Amount in dollars, rounded to cents.","example":47.5},"fully_received":{"type":"boolean"}},"required":["id","vendor_id","status","line_items","ordered_value","received_value","fully_received"]},"PoLineCreate":{"type":"object","properties":{"sku":{"type":"string","minLength":1},"description":{"type":"string","default":""},"quantity":{"type":"number","exclusiveMinimum":0,"maximum":10000,"example":10},"unit_price":{"type":"number","minimum":0,"maximum":100000,"example":4.75}},"required":["sku","quantity","unit_price"]},"PurchaseOrderCreate":{"type":"object","properties":{"vendor_id":{"type":"string","minLength":1},"line_items":{"type":"array","items":{"$ref":"#/components/schemas/PoLineCreate"},"minItems":1}},"required":["vendor_id","line_items"]},"ReceiveRequest":{"type":"object","properties":{"items":{"type":"array","items":{"type":"object","properties":{"sku":{"type":"string","minLength":1},"quantity":{"type":"number","exclusiveMinimum":0,"maximum":10000,"example":10}},"required":["sku","quantity"]},"minItems":1}},"required":["items"]},"InvoiceLine":{"type":"object","properties":{"sku":{"type":"string","minLength":1},"quantity":{"type":"number","exclusiveMinimum":0,"maximum":10000,"example":10},"unit_price":{"type":"number","minimum":0,"maximum":100000,"example":4.75}},"required":["sku","quantity","unit_price"]},"Invoice":{"type":"object","properties":{"id":{"type":"string","example":"inv-5e6f7a8b"},"po_id":{"type":"string"},"vendor_id":{"type":"string"},"invoice_number":{"type":"string"},"status":{"type":"string","enum":["received","matched","approved"]},"line_items":{"type":"array","items":{"$ref":"#/components/schemas/InvoiceLine"}},"total_amount":{"type":"number","description":"Amount in dollars, rounded to cents.","example":47.5},"matched":{"type":"boolean"},"partial_receipt":{"type":["boolean","null"],"description":"null until the invoice is matched."}},"required":["id","po_id","vendor_id","invoice_number","status","line_items","total_amount","matched","partial_receipt"]},"InvoiceCreate":{"type":"object","properties":{"po_id":{"type":"string","minLength":1},"invoice_number":{"type":"string","minLength":1,"example":"INV-1001"},"line_items":{"type":"array","items":{"$ref":"#/components/schemas/InvoiceLine"},"minItems":1}},"required":["po_id","invoice_number","line_items"]},"MatchResult":{"type":"object","properties":{"invoice_id":{"type":"string"},"po_id":{"type":"string"},"status":{"type":"string","enum":["matched"]},"matched":{"type":"boolean","enum":[true]},"partial_receipt":{"type":"boolean"},"ordered_value":{"type":"number","description":"Amount in dollars, rounded to cents.","example":47.5},"received_value":{"type":"number","description":"Amount in dollars, rounded to cents.","example":47.5},"invoice_total":{"type":"number","description":"Amount in dollars, rounded to cents.","example":47.5},"message":{"type":"string","example":"3-way match passed."}},"required":["invoice_id","po_id","status","matched","partial_receipt","ordered_value","received_value","invoice_total","message"]},"GlLine":{"type":"object","properties":{"account":{"type":"string","example":"5000 Materials Expense"},"amount":{"type":"number","description":"Amount in dollars, rounded to cents.","example":47.5}},"required":["account","amount"]},"GlEntry":{"type":"object","properties":{"debits":{"type":"array","items":{"$ref":"#/components/schemas/GlLine"}},"credits":{"type":"array","items":{"$ref":"#/components/schemas/GlLine"}},"balanced":{"type":"boolean"}},"required":["debits","credits","balanced"]},"ApproveResult":{"type":"object","properties":{"invoice_id":{"type":"string"},"status":{"type":"string","enum":["approved"]},"gl_entry":{"$ref":"#/components/schemas/GlEntry"},"vendor_exposure":{"type":"number","description":"Amount in dollars, rounded to cents.","example":47.5}},"required":["invoice_id","status","gl_entry","vendor_exposure"]}},"parameters":{}},"paths":{"/health":{"get":{"tags":["System"],"summary":"Check that the API is running","responses":{"200":{"description":"The API is up.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Health"}}}}}}},"/admin/reset":{"post":{"tags":["System"],"summary":"Reset all data to the seed state","description":"Deletes every purchase order, invoice and created vendor, then restores the two seed vendors and the SKU catalog.","responses":{"200":{"description":"Data was reset.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Reset"}}}}}}},"/vendors":{"get":{"tags":["Vendors"],"summary":"List vendors","responses":{"200":{"description":"All vendors.","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Vendor"}}}}}}},"post":{"tags":["Vendors"],"summary":"Create a vendor","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VendorCreate"}}}},"responses":{"201":{"description":"The new vendor.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Vendor"}}}},"400":{"description":"Invalid body (rule: validation_error).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/vendors/{vendorId}/exposure":{"get":{"tags":["Vendors"],"summary":"Get what the business owes a vendor","description":"open_ap_liability is the sum of total_amount over the vendor's approved invoices (rule: vendor_exposure_math).","parameters":[{"schema":{"type":"string","example":"vnd-001"},"required":true,"name":"vendorId","in":"path"}],"responses":{"200":{"description":"Vendor exposure.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VendorExposure"}}}},"404":{"description":"Vendor not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/skus":{"get":{"tags":["Catalog"],"summary":"List the SKU catalog","responses":{"200":{"description":"All SKUs.","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Sku"}}}}}}}},"/purchase-orders":{"post":{"tags":["Purchase orders"],"summary":"Create a draft purchase order","description":"The vendor must exist and be active (rule: inactive_vendor_gate). Each SKU may appear once.","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PurchaseOrderCreate"}}}},"responses":{"201":{"description":"The new draft purchase order.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PurchaseOrder"}}}},"400":{"description":"Invalid body or inactive vendor.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Vendor not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/purchase-orders/{poId}":{"get":{"tags":["Purchase orders"],"summary":"Get a purchase order","parameters":[{"schema":{"type":"string","example":"po-1a2b3c4d"},"required":true,"name":"poId","in":"path"}],"responses":{"200":{"description":"The purchase order.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PurchaseOrder"}}}},"404":{"description":"Purchase order not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/purchase-orders/{poId}/submit":{"post":{"tags":["Purchase orders"],"summary":"Submit a draft purchase order","description":"Only a draft can be submitted (rule: workflow_gate).","parameters":[{"schema":{"type":"string","example":"po-1a2b3c4d"},"required":true,"name":"poId","in":"path"}],"responses":{"200":{"description":"The submitted purchase order.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PurchaseOrder"}}}},"400":{"description":"The purchase order is not a draft.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Purchase order not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/purchase-orders/{poId}/receive":{"post":{"tags":["Purchase orders"],"summary":"Record goods received","description":"Only a submitted purchase order can receive goods (rule: workflow_gate). Received quantity per line can never exceed the ordered quantity (rule: receive_quantity_limit). The order closes when every line is fully received.","parameters":[{"schema":{"type":"string","example":"po-1a2b3c4d"},"required":true,"name":"poId","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReceiveRequest"}}}},"responses":{"200":{"description":"The updated purchase order.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PurchaseOrder"}}}},"400":{"description":"Invalid body, wrong status or over-receipt.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Purchase order not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/invoices":{"post":{"tags":["Invoices"],"summary":"Create a vendor invoice against a purchase order","description":"The purchase order must be submitted or closed (rule: workflow_gate). Invoice numbers are unique per vendor, compared case-insensitively and ignoring surrounding spaces (rule: duplicate_invoice_detection). Every SKU must be on the purchase order, once (rule: invoice_line_validation). Everything invoiced on the purchase order, quantities and total, can never exceed what was received (rule: overpayment_protection).","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvoiceCreate"}}}},"responses":{"201":{"description":"The new invoice.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Invoice"}}}},"400":{"description":"Invalid body or a business rule rejected the invoice.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Purchase order not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/invoices/{invoiceId}":{"get":{"tags":["Invoices"],"summary":"Get an invoice","parameters":[{"schema":{"type":"string","example":"inv-5e6f7a8b"},"required":true,"name":"invoiceId","in":"path"}],"responses":{"200":{"description":"The invoice.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Invoice"}}}},"404":{"description":"Invoice not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/invoices/{invoiceId}/match":{"post":{"tags":["Invoices"],"summary":"Run the 3-way match","description":"Compares the purchase order, the goods received and the invoice. partial_receipt is true when any line of the purchase order is not fully received (rule: partial_receipt_flag). An approved invoice cannot be matched again (rule: workflow_gate).","parameters":[{"schema":{"type":"string","example":"inv-5e6f7a8b"},"required":true,"name":"invoiceId","in":"path"}],"responses":{"200":{"description":"The match result.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MatchResult"}}}},"400":{"description":"The invoice is already approved.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Invoice not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/invoices/{invoiceId}/approve":{"post":{"tags":["Invoices"],"summary":"Approve a matched invoice and post it to the ledger","description":"The invoice must be matched first (rule: three_way_match_gate) and can be approved once (rule: duplicate_approval). Approval posts a balanced ledger entry: debit 5000 Materials Expense, credit 2000 Accounts Payable (rule: gl_balance).","parameters":[{"schema":{"type":"string","example":"inv-5e6f7a8b"},"required":true,"name":"invoiceId","in":"path"}],"responses":{"200":{"description":"The approval result.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApproveResult"}}}},"400":{"description":"Not matched, or already approved.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Invoice not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}},"webhooks":{}}